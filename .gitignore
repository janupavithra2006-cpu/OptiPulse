# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
.venv/
venv/
env/
ENV/

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Local runtime logs (keep directory structure via .gitkeep)
logs/*.log
!logs/.gitkeep

# Temporary test files / cache
*.tmp
scratch/
